<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- ========================================================
             1. PARÃMETROS DE CONEXIÃ“N JDBC (MySQL 8)
             ======================================================== -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/mercado_db?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">12345</property>

        <!-- (OPCIONAL: Para usar H2 en memoria sin necesidad de MySQL instalado, descomenta esto:)
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:mercado_db;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>
        -->

        <!-- ========================================================
             2. DIALECTO HIBERNATE
             ======================================================== -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- ========================================================
             3. LOGGING DE CONSULTAS SQL EN CONSOLA (NETBEANS)
             ======================================================== -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.highlight_sql">true</property>

        <!-- ========================================================
             4. GESTIÃ“N AUTOMÃTICA DEL ESQUEMA DDL
             ======================================================== -->
        <!-- "update": Crea o actualiza tablas y columnas automÃ¡ticamente sin borrar datos existentes -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Pool de conexiones integrado simple -->
        <property name="hibernate.connection.pool_size">5</property>

        <!-- Contexto de sesiÃ³n actual para el hilo de ejecuciÃ³n -->
        <property name="hibernate.current_session_context_class">thread</property>

        <!-- ========================================================
             5. MAPEO DE ENTIDADES JPA
             ======================================================== -->
        <mapping class="com.mercado.model.Categoria"/>
        <mapping class="com.mercado.model.FichaNutricional"/>
        <mapping class="com.mercado.model.Proveedor"/>
        <mapping class="com.mercado.model.Producto"/>
    </session-factory>
</hibernate-configuration>
